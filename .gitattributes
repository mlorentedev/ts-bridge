# Exclude development and CI/CD files from source archives (e.g. "Download ZIP")
.github export-ignore
.gitignore export-ignore
.release-please-manifest.json export-ignore
release-please-config.json export-ignore
main_test.go export-ignore
.gitattributes export-ignore
specs export-ignore

# Shell scripts MUST use LF line endings even when checked out on Windows —
# CRLF breaks bash/bats interpretation of shebangs and case statements.
*.sh text eol=lf
*.bash text eol=lf
*.bats text eol=lf

# go.mod and go.sum MUST be LF on every OS: with core.autocrlf=true a Windows
# checkout gets CRLF copies, and `go mod tidy -diff` then reports a whole-file
# diff that Git itself does not (#498).
go.mod text eol=lf
go.sum text eol=lf
