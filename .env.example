# ── Required ─────────────────────────────────────────────────
#
# Auth key (tskey- for Tailscale SaaS, hskey- for Headscale)
#   Tailscale: https://login.tailscale.com/admin/settings/keys
#   Headscale: headscale preauthkeys create --user <ID> --reusable --ephemeral --expiration 8760h
#
# For better security, consider omitting this and passing the --auth-key-file CLI flag.
TS_AUTHKEY=tskey-auth-xxxxx

# Target host:port on the Tailscale/Headscale network
# MagicDNS (recommended): use the device name from your tailnet
#   my-desktop:3389         (RDP via MagicDNS hostname)
#   acemagic-lab-1:3389     (RDP via MagicDNS)
# Fallback to IP if MagicDNS is not enabled:
#   100.82.151.104:3389     (RDP via Tailscale IP)
#   100.64.0.5:22           (SSH via Headscale IP)
#
# Alternatively, import a named profile and use --profile <name> on connect:
#   ts-bridge import home "tsb://acemagic-office:45000?cp=saas"
#   ts-bridge connect --profile home
# TS_TARGET can still be set to override --profile at runtime.
TS_TARGET=my-desktop:3389

# ── Optional ─────────────────────────────────────────────────
#
# For advanced options (local address, control URL, timeouts, host config),
# see the canonical configuration reference:
# https://mlorentedev.github.io/ts-bridge/configuration/
