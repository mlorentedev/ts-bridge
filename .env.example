# ── Required ─────────────────────────────────────────────────
#
# Tailscale auth key
# Generate at: https://login.tailscale.com/admin/settings/keys
# Recommended: ephemeral + reusable (node auto-deletes on exit)
TS_AUTHKEY=tskey-auth-xxxxx

# Target host:port on the Tailscale network
# Examples:
#   100.82.151.104:3389   (RDP via Tailscale IP)
#   my-desktop:3389       (RDP via MagicDNS hostname)
#   100.64.0.5:22         (SSH)
TS_TARGET=100.x.x.x:3389

# ── Optional (sensible defaults) ─────────────────────────────
# See README.md → Configuration Reference for all options.
#
# TS_LOCAL_ADDR=127.0.0.1:33389   # Local bind address
# TS_CONTROL_URL=                  # Custom control plane (e.g. Headscale)
