# Required: Tailscale auth key
# Generate at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxx

# Required: Target address (Tailscale IP:PORT)
TS_TARGET=100.x.x.x:3389

# Optional: Local bind address (default: 127.0.0.1:33389)
# TS_LOCAL_ADDR=127.0.0.1:33389

# Optional: Hostname for the ephemeral node (default: ts-bridge)
# TS_HOSTNAME=ts-bridge

# Optional: State directory (default: ./ts-state)
# TS_STATE_DIR=./ts-state

# Optional: Connection timeout (default: 30s)
# TS_TIMEOUT=30s
