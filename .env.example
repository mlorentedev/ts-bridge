# ── Required ─────────────────────────────────────────────────
#
# Auth key (tskey- for Tailscale SaaS, hskey- for Headscale)
#   Tailscale: https://login.tailscale.com/admin/settings/keys
#   Headscale: headscale preauthkeys create --user <ID> --reusable --ephemeral --expiration 8760h
TS_AUTHKEY=tskey-auth-xxxxx

# Target host:port on the Tailscale/Headscale network
# MagicDNS (recommended): use the device name from your tailnet
#   my-desktop:3389         (RDP via MagicDNS hostname)
#   acemagic-lab-1:3389     (RDP via MagicDNS)
# Fallback to IP if MagicDNS is not enabled:
#   100.82.151.104:3389     (RDP via Tailscale IP)
#   100.64.0.5:22           (SSH via Headscale IP)
TS_TARGET=my-desktop:3389

# ── Optional (sensible defaults) ─────────────────────────────
# See README.md → Configuration Reference for all options.
# Note: The CLI binary reads .env automatically. No wrapper scripts needed.
#
# TS_LOCAL_ADDR=127.0.0.1:33389   # Local bind address (default in manual mode; auto mode derives a unique port from the target)
# TS_CONTROL_URL=                  # Custom control plane (e.g. https://vpn.example.com)
# TS_VERBOSE=true                  # Verbose logging (accepts: 1, true, yes, on — case-insensitive)
# TS_IDLE_TIMEOUT=                 # Close idle conns after this duration (e.g. 30m). Default: disabled.
# TS_DIAL_TIMEOUT=5s               # Per-connection target dial timeout (distinct from TS_TIMEOUT which only covers tsnet init).
# TS_DIAL_RETRIES=3                # Max retries for transient target dial failures (0 disables).
# TS_DIAL_BACKOFF_BASE=1s          # Base backoff for retries (multiplied by 2^attempt).
# TS_DIAL_BACKOFF_MAX=30s          # Cap on backoff duration per retry.
