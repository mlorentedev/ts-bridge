# ── Required ─────────────────────────────────────────────────
#
# Auth key (tskey- for Tailscale SaaS, hskey- for Headscale)
#   Tailscale: https://login.tailscale.com/admin/settings/keys
#   Headscale: headscale preauthkeys create --user <ID> --reusable --ephemeral --expiration 8760h
#
# SECURITY NOTE: Prefer `ts-bridge auth set --profile <name>` for managed,
# owner-only storage. Plaintext keys in .env or environment variables are
# readable by child processes. `--auth-key-file` remains an explicit override.
TS_AUTHKEY=tskey-auth-xxxxx

# Static target host:port on the Tailscale/Headscale network.
# Use either TS_TARGET for one destination or TS_SOCKS5_ADDR for dynamic mode.
# MagicDNS (recommended): use the device name from your tailnet
#   my-desktop:3389         (RDP via MagicDNS hostname)
#   acemagic-lab-1:3389     (RDP via MagicDNS)
# Fallback to IP if MagicDNS is not enabled:
#   100.82.151.104:3389     (RDP via Tailscale IP)
#   100.64.0.5:22           (SSH via Headscale IP)
#
# Alternatively, import a named profile and use --profile <name> on connect:
#   ts-bridge import home "tsb://acemagic-office:45000?cp=saas"
#   ts-bridge connect --profile home
# TS_TARGET can still be set to override --profile at runtime.
TS_TARGET=my-desktop:3389

# Dynamic multi-target mode (alternative to TS_TARGET). The listener must be
# loopback-only. Use YAML `socks5_routes` or repeat `connect --route` when an
# allow-list is required.
# TS_SOCKS5_ADDR=127.0.0.1:1080

# ── Optional ─────────────────────────────────────────────────
#
# If the configured Headscale control plane is blocked by local DNS or TLS
# inspection but an SSH bastion can reach it, bootstrap through OpenSSH.
# Host-key verification remains enabled; configure trusted keys in ~/.ssh.
# TS_CONTROL_URL=https://vpn.example.com
# TS_BOOTSTRAP_SSH=deployer@bastion.example.com
# TS_BOOTSTRAP_SOCKS_ADDR=127.0.0.1:1055
#
# For advanced options (local address, control URL, timeouts, host config),
# see the canonical configuration reference:
# https://mlorentedev.github.io/ts-bridge/configuration/
